# Copia este fichero a .env.local y rellena los valores reales.
# .env / .env.local ya están en el .gitignore de la raíz — nunca se suben.

# Token público de Mapbox (mapbox-gl y la Geocoding API) para el mapa
# interactivo de /indexado. Es un token PÚBLICO por diseño de Mapbox —
# restríngelo por dominio (URL restrictions) en el dashboard de tu cuenta,
# no por secreto. Sin él, la sección del mapa avisa en vez de fallar en
# silencio.
NEXT_PUBLIC_MAPBOX_TOKEN=
