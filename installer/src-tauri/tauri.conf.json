{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Instalador de Lumi",
  "version": "0.1.0",
  "identifier": "com.lumi.installer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5373",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Instalador de Lumi",
        "width": 640,
        "height": 460,
        "center": true,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
